<?xml version ="1.0"?>
<robot name="mobile_base_with_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find my_robot_description)/urdf/common_properties.xacro" />
    <xacro:include filename="$(find my_robot_description)/urdf/mobile_base.xacro" />
    <xacro:include filename="$(find my_robot_description)/urdf/mobile_base_gazebo.xacro" />
    <xacro:include filename="$(find mobile_base_with_arm)/urdf/two_link_arm_base.urdf.xacro" />
    <joint name="mobile_base_arm_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="${(base_length - arm_base_link_length)/2} 0 ${base_height}" rpy="0 0 0"/>
    </joint>
    <xacro:include filename="$(find my_robot_description)/urdf/camera_gazebo.xacro" />
</robot>
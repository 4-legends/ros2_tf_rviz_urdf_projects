<?xml version ="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="arm_base_link_length" value="0.1" />
    <xacro:property name="arm_base_link_width" value="0.1" />
    <xacro:property name="arm_base_link_height" value="0.02" />
    <xacro:property name="forearm_link_length" value="0.3" />
    <xacro:property name="forearm_link_radius" value="0.02" />
    <xacro:property name="hand_link_radius" value="0.02" />
    <xacro:property name="hand_link_length" value="0.3" />
    <xacro:include filename="common.xacro" />
    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${arm_base_link_length} ${arm_base_link_width} ${arm_base_link_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_base_link_height / 2}" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <box size="${arm_base_link_length} ${arm_base_link_width} ${arm_base_link_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_base_link_height / 2}" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia 
            m="0.5" 
            x="${arm_base_link_length}" 
            y="${arm_base_link_width}" 
            z="${arm_base_link_height}" 
            o_xyz="0 0 ${arm_base_link_height / 2}" 
            o_rpy="0 0 0"
        />
    </link>

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder radius="${forearm_link_radius}" length="${forearm_link_length}"/>
            </geometry>
            <origin xyz="0 0 ${forearm_link_length / 2}" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${forearm_link_radius}" length="${forearm_link_length}"/>
            </geometry>
            <origin xyz="0 0 ${forearm_link_length / 2}" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia 
            m="0.3" 
            r="${forearm_link_radius}" 
            l="${forearm_link_length}" 
            o_xyz="0 0 ${forearm_link_length / 2}" 
            o_rpy="0 0 0"
        />
    </link>

    <link name="hand_link">
        <visual>
            <geometry>
                <cylinder radius="${hand_link_radius}" length="${hand_link_length}"/>
            </geometry>
            <origin xyz="0 0 ${hand_link_length / 2}" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${hand_link_radius}" length="${hand_link_length}"/>
            </geometry>
            <origin xyz="0 0 ${hand_link_length / 2}" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia 
            m="0.3" 
            r="${hand_link_radius}" 
            l="${hand_link_length}" 
            o_xyz="0 0 ${hand_link_length / 2}" 
            o_rpy="0 0 0"
        />
    </link>

    <joint name="arm_base_forearm_joint" type="revolute">
        <parent link="arm_base_link"/>
        <child link="forearm_link"/>
        <origin xyz="0 0 ${arm_base_link_height}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

    <joint name="forearm_hand_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="hand_link"/>
        <origin xyz="0 0 ${forearm_link_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system" 
            name="gz::sim::systems::JointPositionController">
            <joint_name>arm_base_forearm_joint</joint_name>
            <p_gain>5.0</p_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system" 
            name="gz::sim::systems::JointPositionController">
            <joint_name>forearm_hand_joint</joint_name>
            <p_gain>3.0</p_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system" 
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>arm_base_forearm_joint</joint_name>
            <joint_name>forearm_hand_joint</joint_name>
        </plugin>
    </gazebo>
</robot>